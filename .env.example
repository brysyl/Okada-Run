# Leave blank to use the localStorage leaderboard fallback.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Edge function secrets (NOT Vite vars; never put these in a VITE_ variable) ---
# Set with: supabase secrets set SCORE_RATE_LIMIT_PER_MINUTE=5 IP_HASH_SALT=<random> ALLOWED_ORIGIN=https://your-site.example
# SCORE_RATE_LIMIT_PER_MINUTE=5   (default 5 submissions per IP per minute)
# IP_HASH_SALT=                   (random string; salts the SHA-256 of client IPs)
# ALLOWED_ORIGIN=*                (CORS origin; set to your site in production)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into edge functions automatically.
# The service role key bypasses RLS and must never be exposed to the browser.
